# Base URL of the backend API (include the /api suffix).
# Leave unset to use the local dev server at http://localhost:5000/api.
VITE_API_BASE=https://your-api-host.example.com/api

# logo.dev PUBLISHABLE token (pk_...) for company logos on the Experience page.
# Get it from your logo.dev dashboard. NEVER use a secret (sk_...) key here —
# anything VITE_-prefixed is bundled into the public browser build.
VITE_LOGO_DEV_KEY=
