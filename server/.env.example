PORT=5000
# Strong, random admin secret used to log into the /admin panel.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# If left empty, admin login and all write operations are disabled.
ADMIN_TOKEN=
# Comma-separated list of allowed front-end origins (use '*' to allow all).
CORS_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
